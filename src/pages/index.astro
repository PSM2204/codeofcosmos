---
const siteName = "Code of Cosmos";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteName} - Premium Vedic Astrology Consultations</title>
    <meta name="description" content="Understand the patterns shaping your life. Premium, confidential Vedic astrology consultations.">
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #0B0F19 0%, #1a1f3a 100%);
        color: #FFFFF0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .container {
        text-align: center;
        padding: 2rem;
        max-width: 800px;
      }
      h1 {
        font-size: 3rem;
        margin-bottom: 1rem;
        color: #C5A059;
      }
      p {
        font-size: 1.25rem;
        line-height: 1.6;
        margin-bottom: 2rem;
        color: #FFFFF0;
      }
      .cta-button {
        display: inline-block;
        padding: 1rem 2rem;
        background: #C5A059;
        color: #0B0F19;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
        transition: transform 0.2s;
      }
      .cta-button:hover {
        transform: translateY(-2px);
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Code of Cosmos</h1>
      <p>Understand the patterns shaping your life.<br>
      Premium Vedic astrology consultations for the modern professional.</p>
      <a href="#" class="cta-button">Book a Consultation</a>
    </div>
  </body>
</html>
